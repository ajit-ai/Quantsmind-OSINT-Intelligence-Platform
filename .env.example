# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production-use-50-random-chars
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Postgres ---
POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint_password
DATABASE_URL=postgres://osint:osint_password@postgres:5432/osint

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- MinIO / S3 ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=osint-raw
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=false

# --- JWT ---
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Scraping ---
SCRAPY_CONCURRENT_REQUESTS=8
COLLECTION_RATE_LIMIT_RPS=1
